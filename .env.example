# ===== Ajino v5 .env.example =====
# Copy to .env and fill in real values

# ─── DATABASE ─────────────────────────────────────────
POSTGRES_URL=postgresql://ajinov5:CHANGEME@localhost:5432/ajinov5
POSTGRES_PASSWORD=CHANGEME

# ─── LLM PROVIDERS ────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
# Get from: https://platform.deepseek.com/api_keys

OPENAI_API_KEY=sk-...
# Optional fallback

# ─── TOOLS ────────────────────────────────────────────
SERPER_API_KEY=...
# Get from: https://serper.dev

# ─── LITELLM ──────────────────────────────────────────
LITELLM_MASTER_KEY=sk-CHANGEME

# ─── TELEGRAM ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
# Get from: @BotFather on Telegram

# ─── CLOUDFLARE R2 ────────────────────────────────────
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=agent-storage
R2_BACKUPS_BUCKET=agent-backups
R2_ENDPOINT=https://{ACCOUNT_ID}.r2.cloudflarestorage.com

# ─── CLOUDFLARE AI ────────────────────────────────────
CF_WORKERS_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/...
CF_WORKERS_AI_TOKEN=...

# ─── CLOUDFLARE TUNNEL ────────────────────────────────
TUNNEL_TOKEN=...
